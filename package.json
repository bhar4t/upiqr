{
  "name": "upiqr",
  "version": "1.4.1",
  "description": "Zero-dependency UPI QR code (PNG) and intent link generator for NPCI-compliant payments - works in Node.js and the browser, written in TypeScript.",
  "homepage": "https://github.com/bhar4t/upiqr#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": {
    "./dist/index.js": "./dist/index.browser.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "minify": "jsmin -o dist/types/upiqr.d.ts dist/types/upiqr.d.ts && jsmin -o dist/index.d.ts dist/index.d.ts && jsmin -o dist/index.browser.d.ts dist/index.browser.d.ts && uglifyjs -o dist/index.js dist/index.js --mangle && uglifyjs -o dist/index.browser.js dist/index.browser.js --mangle",
    "build": "npm run clean && tsc && npm run minify",
    "test": "tsx --test src/__tests__/encoder.test.ts src/__tests__/roundtrip.test.ts src/__tests__/index.test.ts src/__tests__/canvas.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhar4t/upiqr"
  },
  "keywords": [
    "upi",
    "upiqr",
    "qrcode",
    "qr code",
    "qr code generator",
    "qr code npm",
    "zero dependency",
    "zero dependencies",
    "dependency-free",
    "typescript",
    "payment",
    "accept payment",
    "upi payment",
    "upi qr code generator",
    "upi qr code",
    "upi qr generator",
    "upi id",
    "vpa",
    "bharat qr",
    "india payments",
    "npci",
    "npci upi"
  ],
  "publishConfig": {
    "provenance": true
  },
  "author": "Bharat Sahu",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bhar4t/"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsmin": "^1.0.1",
    "jsqr": "^1.4.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uglify-js": "^3.19.3"
  }
}
